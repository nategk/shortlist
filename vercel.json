{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "echo 'static app, no build step'",
  "outputDirectory": "app",
  "functions": {
    "api/admin/import.js": {
      "maxDuration": 300
    },
    "api/crawl.js": {
      "maxDuration": 300
    },
    "api/sync.js": {
      "maxDuration": 300
    },
    "api/airtable/webhook.js": {
      "maxDuration": 120
    },
    "api/listings/[id].js": {
      "maxDuration": 60
    },
    "api/searches/[id].js": {
      "maxDuration": 60
    },
    "api/intake.js": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/sync",
      "schedule": "17 9 * * *"
    },
    {
      "path": "/api/crawl",
      "schedule": "7 11 * * *"
    }
  ]
}
